A library and one consumer, each holding Go and TypeScript. The consumer
calls Greet and greet and builds an Options naming the name in each language.
Spare, spare, Farewell and farewell are referenced by nothing.

-- scope.json --
{"target": {"path": "lib"}, "consumers": [{"path": "consumer"}]}
-- lib/deadset.json --
{"target": {"kind": "library"}}
-- lib/go.mod --
module example.com/lib

go 1.27
-- lib/lib.go --
// Package lib is a library one consumer reads.
package lib

// Options is what a caller configures.
type Options struct {
	Name  string
	Spare int
}

// Greet greets the named caller.
func Greet(o Options) string { return "hello " + o.Name }

// Farewell is what no caller says.
func Farewell() string { return "bye" }
-- lib/package.json --
{"name": "@example/lib", "private": true, "version": "0.0.0", "type": "module", "main": "./lib.ts"}
-- lib/tsconfig.json --
{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
-- lib/lib.ts --
export interface Options {
  name: string;
  spare?: number;
}

export function greet(options: Options): string {
  return "hello " + options.name;
}

export function farewell(): string {
  return "bye";
}
-- consumer/go.mod --
module example.com/consumer

go 1.27

require example.com/lib v0.0.0

replace example.com/lib => ../lib
-- consumer/main.go --
package main

import (
	"fmt"

	"example.com/lib"
)

func main() { fmt.Println(lib.Greet(lib.Options{Name: "consumer"})) }
-- consumer/package.json --
{"name": "@example/consumer", "private": true, "version": "0.0.0", "type": "module"}
-- consumer/tsconfig.json --
{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
-- consumer/main.ts --
import { greet } from "../lib/lib.js";

console.log(greet({ name: "consumer" }));
