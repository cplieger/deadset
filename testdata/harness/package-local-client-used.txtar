A server whose wire type only its own package references, and
a browser client that uses the TypeScript interface generated from it.
deadset-edges.json pairs the two declarations.

web/src/wire/types.gen.ts is wiregen's GenerateTypes output for
ServerEvent registered by its package path and name, unedited.

-- deadset.json --
{
  "target": { "kind": "application" },
  "ts": { "entry_files": ["web/src/app.ts"] }
}
-- deadset-edges.json --
{
  "description": "The wire type the server relays, paired with the TypeScript interface generated from it.",
  "edges": [
    {
      "id": "wire/ServerEvent",
      "because": "generated",
      "provides": "go://example.com/server/internal/wire#ServerEvent",
      "used_by": "ts://@example/web/src/wire/types.gen.ts#ServerEvent"
    }
  ]
}
-- go.mod --
module example.com/server

go 1.27.1
-- main.go --
// Command server opens an event stream on standard output, then relays the
// stream it reads on standard input, one JSON object per line.
package main

import (
	"os"

	"example.com/server/internal/wire"
)

func main() {
	if err := wire.Open(os.Stdout); err != nil {
		os.Exit(1)
	}
	if err := wire.Relay(os.Stdout, os.Stdin); err != nil {
		os.Exit(1)
	}
}
-- internal/wire/event.go --
// Package wire carries the event stream between the server and its browser
// client.
package wire

// ServerEvent is one event of the stream, as the browser client decodes it.
type ServerEvent struct {
	// Kind names what happened.
	Kind string `json:"kind"`
	// Seq orders the events of one stream.
	Seq int `json:"seq"`
}
-- internal/wire/open.go --
package wire

import (
	"encoding/json"
	"io"
)

// Open writes the event that opens a stream.
func Open(dst io.Writer) error {
	return json.NewEncoder(dst).Encode(ServerEvent{Kind: "open"})
}
-- internal/wire/relay.go --
package wire

import "io"

// Relay copies the event stream from src to dst without decoding it.
func Relay(dst io.Writer, src io.Reader) error {
	_, err := io.Copy(dst, src)
	return err
}
-- web/package.json --
{
  "name": "@example/web",
  "private": true,
  "type": "module"
}
-- web/tsconfig.json --
{
  "compilerOptions": {
    "strict": true,
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "noEmit": true
  },
  "include": ["src"]
}
-- web/src/app.ts --
import type { ServerEvent } from "./wire/types.gen.js";

/** Renders one relayed event as a line of the event log. */
export function describe(event: ServerEvent): string {
  return `${String(event.seq)} ${event.kind}`;
}
-- web/src/wire/types.gen.ts --
// CODE-GENERATED by wiregen, DO NOT EDIT.

/** ServerEvent is one event of the stream, as the browser client decodes it. */
export interface ServerEvent {
  /** Kind names what happened. */
  kind: string;
  /** Seq orders the events of one stream. */
  seq: number;
}

