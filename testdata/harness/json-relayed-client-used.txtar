A server that decodes and encodes its wire type with encoding/json and names
none of its fields, and a browser client that uses the TypeScript interface
generated from it and reads one of its properties.
deadset-edges.json pairs the two types and none of their members.

web/src/wire/types.gen.ts is wiregen's GenerateTypes output for
ServerEvent registered by its package path and name, unedited.

-- deadset.json --
{
  "target": { "kind": "application" },
  "ts": { "entry_files": ["web/src/app.ts"] }
}
-- deadset-edges.json --
{
  "description": "The wire type the server relays, paired with the TypeScript interface generated from it.",
  "edges": [
    {
      "id": "wire/ServerEvent",
      "because": "generated",
      "provides": "go://example.com/server/internal/wire#ServerEvent",
      "used_by": "ts://@example/web/src/wire/types.gen.ts#ServerEvent"
    }
  ]
}
-- go.mod --
module example.com/server

go 1.27.1
-- main.go --
// Command server relays the event stream it reads on standard input to
// standard output, one JSON object per line.
package main

import (
	"os"

	"example.com/server/internal/wire"
)

func main() {
	if err := wire.Relay(os.Stdout, os.Stdin); err != nil {
		os.Exit(1)
	}
}
-- internal/wire/event.go --
// Package wire carries the event stream between the server and its browser
// client.
package wire

// ServerEvent is one event of the stream, as the browser client decodes it.
type ServerEvent struct {
	// Kind names what happened.
	Kind string `json:"kind"`
	// Seq orders the events of one stream.
	Seq int `json:"seq"`
}
-- internal/wire/relay.go --
package wire

import (
	"encoding/json"
	"errors"
	"io"
)

// Relay decodes each event of the stream from src and encodes it to dst.
func Relay(dst io.Writer, src io.Reader) error {
	dec, enc := json.NewDecoder(src), json.NewEncoder(dst)
	for {
		var event ServerEvent
		if err := dec.Decode(&event); err != nil {
			if errors.Is(err, io.EOF) {
				return nil
			}
			return err
		}
		if err := enc.Encode(&event); err != nil {
			return err
		}
	}
}
-- web/package.json --
{
  "name": "@example/web",
  "private": true,
  "type": "module"
}
-- web/tsconfig.json --
{
  "compilerOptions": {
    "strict": true,
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "noEmit": true
  },
  "include": ["src"]
}
-- web/src/app.ts --
import type { ServerEvent } from "./wire/types.gen.js";

/** Renders one event as a line of the event log. */
export function describe(event: ServerEvent): string {
  return String(event.seq);
}
-- web/src/wire/types.gen.ts --
// CODE-GENERATED by wiregen, DO NOT EDIT.

/** ServerEvent is one event of the stream, as the browser client decodes it. */
export interface ServerEvent {
  /** Kind names what happened. */
  kind: string;
  /** Seq orders the events of one stream. */
  seq: number;
}

