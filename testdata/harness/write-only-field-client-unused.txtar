A server that sets a field of its wire type and never reads it, and
a browser client that never reads the TypeScript property generated from that field.
deadset-edges.json pairs the field with the property.

web/src/wire/types.gen.ts is wiregen's GenerateTypes output for
ServerEvent registered by its package path and name, unedited.

-- deadset.json --
{
  "target": { "kind": "application" },
  "ts": { "entry_files": ["web/src/app.ts"] }
}
-- deadset-edges.json --
{
  "description": "The field the browser client reads, paired with the property generated from it.",
  "edges": [
    {
      "id": "wire/ServerEvent.Kind",
      "because": "generated",
      "provides": "go://example.com/server/internal/wire#ServerEvent.Kind",
      "used_by": "ts://@example/web/src/wire/types.gen.ts#ServerEvent.kind"
    }
  ]
}
-- go.mod --
module example.com/server

go 1.27.1
-- main.go --
// Command server writes the event that opens a stream on standard output.
package main

import (
	"os"

	"example.com/server/internal/wire"
)

func main() {
	event := wire.ServerEvent{Kind: "open", Seq: 1}
	if _, err := os.Stdout.Write(event.AppendLine(nil)); err != nil {
		os.Exit(1)
	}
}
-- internal/wire/event.go --
// Package wire carries the event stream between the server and its browser
// client.
package wire

// ServerEvent is one event of the stream, as the browser client decodes it.
type ServerEvent struct {
	// Kind names what happened.
	Kind string `json:"kind"`
	// Seq orders the events of one stream.
	Seq int `json:"seq"`
}
-- internal/wire/line.go --
package wire

import "strconv"

// AppendLine appends the event's line of the stream to b.
func (e *ServerEvent) AppendLine(b []byte) []byte {
	b = strconv.AppendInt(b, int64(e.Seq), 10)
	return append(b, '\n')
}
-- web/package.json --
{
  "name": "@example/web",
  "private": true,
  "type": "module"
}
-- web/tsconfig.json --
{
  "compilerOptions": {
    "strict": true,
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "noEmit": true
  },
  "include": ["src"]
}
-- web/src/app.ts --
import type { ServerEvent } from "./wire/types.gen.js";

/** Renders one event as a line of the event log. */
export function describe(event: ServerEvent): string {
  return String(event.seq);
}
-- web/src/wire/types.gen.ts --
// CODE-GENERATED by wiregen, DO NOT EDIT.

/** ServerEvent is one event of the stream, as the browser client decodes it. */
export interface ServerEvent {
  /** Kind names what happened. */
  kind: string;
  /** Seq orders the events of one stream. */
  seq: number;
}

